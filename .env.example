# Server configuration
PORT=3000
HOST=127.0.0.1

# LinkedIn API mode: "live" (real LinkedIn OAuth & /rest/posts) or "mock" (local sandbox server for testing)
LINKEDIN_MODE=live

# LinkedIn API settings (for live mode)
LINKEDIN_API_VERSION=202610
LINKEDIN_OAUTH_BASE_URL=https://www.linkedin.com
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Optional pre-seeded LinkedIn OAuth app credentials (can also be entered in the UI)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 32-byte encryption key for AES-256-GCM token storage (64 hex chars recommended).
# Leave blank to auto-generate a local key at .data/.master.key on first startup.
TOKEN_ENCRYPTION_KEY=

# Storage & logging paths
DATABASE_PATH=.data/app.db
LOG_FILE_PATH=.data/logs/app.log
LOG_LEVEL=info

# Background worker & retry configuration
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=120000
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=5000
RETRY_MAX_DELAY_MS=300000
HTTP_TIMEOUT_MS=15000
